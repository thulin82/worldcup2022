# Copy to config/config.env and fill in real values (config/*.env is gitignored).

# football-data.org API token — https://www.football-data.org/client/register
API_KEY=

# RapidAPI key for the divanscore host — https://rapidapi.com/
RAPIDAPI_KEY=

# Optional, defaults shown
NODE_ENV=development
PORT=4567
FOOTBALL_API_BASE_URL=https://api.football-data.org/v4
DIVANSCORE_BASE_URL=https://divanscore.p.rapidapi.com
COMPETITION_ID=2000
SEASON=2026
TOURNAMENT_ID=16
SEASON_ID=58210
CACHE_TTL_MS=300000
